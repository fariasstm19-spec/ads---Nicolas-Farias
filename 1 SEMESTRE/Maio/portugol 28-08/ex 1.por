programa {
  funcao inicio() {
    real id
    cadeia nome, equipe

    escreva("qual e seu nome ? ")
    leia(nome)
    escreva("qual e sei ID ? ")
    leia(id)
    escreva("qual e sua equipe ? ")
    leia(equipe)

    escreva("  === DADOS DO JOGADOR CADASTRADO ===\n ID: ", id ,"\n Jogador: ", nome ,"\n Equipe: ", equipe)
    
  }
}
